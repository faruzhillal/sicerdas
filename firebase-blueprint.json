{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Information about a user (student or admin)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "studentId": { "type": "string" },
        "nisn": { "type": "string" },
        "class": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "parentName": { "type": "string" },
        "parentJob": { "type": "string" },
        "parentIncome": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "studentRanking": {
      "title": "Student Ranking",
      "description": "Ranking data for a student in a specific class",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "class": { "type": "string" },
        "score": { "type": "number" },
        "rank": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "class", "score", "rank"]
    },
    "scholarship": {
      "title": "Scholarship",
      "description": "Scholarship programs and recipients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "announced"] },
        "recipients": { "type": "array" }
      },
      "required": ["id", "name", "status"]
    },
    "scholarshipApplication": {
      "title": "Scholarship Application",
      "description": "Information provided by student when applying for a scholarship",
      "type": "object",
      "properties": {
        "scholarshipId": { "type": "string" },
        "scholarshipName": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentClass": { "type": "string" },
        "nisn": { "type": "string" },
        "parentName": { "type": "string" },
        "parentJob": { "type": "string" },
        "parentIncome": { "type": "string" },
        "criteriaValues": {
          "type": "object",
          "properties": {
            "gpa": { "type": "number", "description": "Nilai Rata-rata / IPK (0-100)" },
            "parentIncomeValue": { "type": "number", "description": "Nilai penghasilan untuk perhitungan (1-5)" },
            "dependents": { "type": "number", "description": "Jumlah tanggungan orang tua" },
            "achievements": { "type": "number", "description": "Skor prestasi (1-5)" }
          }
        },
        "notes": { "type": "string" },
        "declaration": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminComment": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scholarshipId", "studentId", "nisn", "parentName", "parentIncome", "declaration"]
    },
    "complaint": {
      "title": "Student Complaint",
      "description": "Complaints filed by students",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_progress", "resolved"] },
        "adminReply": { "type": "string" },
        "repliedAt": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "message", "status"]
    },
    "complaintChat": {
      "title": "Complaint Chat Message",
      "description": "Individual messages in a complaint thread",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["student", "admin"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderRole", "message", "timestamp"]
    },
    "criterion": {
      "title": "Scoring Criterion",
      "description": "Definition of a scoring criterion with weight",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "weight": { "type": "number" },
        "type": { "type": "string", "enum": ["benefit", "cost"] },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "weight", "type"]
    },
    "class": {
      "title": "School Class",
      "description": "Available school classes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "news": {
      "title": "School News",
      "description": "Latest news and articles about the school",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageURL": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "publishedAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "user",
      "description": "Collection of user profiles"
    },
    "rankings": {
      "schema": "studentRanking",
      "description": "Collection of student rankings per class"
    },
    "criteria": {
      "schema": "criterion",
      "description": "Definitions of criteria used for scoring"
    },
    "criteria_scores": {
      "schema": "object",
      "description": "Scores for each criterion per student"
    },
    "scholarships": {
      "schema": "scholarship",
      "description": "Collection of scholarship programs"
    },
    "scholarship_applications": {
      "schema": "scholarshipApplication",
      "description": "Applications for scholarships"
    },
    "complaints": {
      "schema": "complaint",
      "description": "Collection of student complaints"
    },
    "complaints/{complaintId}/messages": {
      "schema": "complaintChat",
      "description": "Subcollection of chat messages for a specific complaint"
    },
    "classes": {
      "schema": "class",
      "description": "Collection of school classes"
    },
    "news": {
      "schema": "news",
      "description": "Collection of school news and articles"
    }
  }
}
