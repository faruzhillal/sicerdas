rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token != null && 
             'email' in request.auth.token && (
               request.auth.token.email.lowerAscii() == 'faruzhillal465@gmail.com' ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin')
             );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (
        isOwner(userId) || 
        isAdmin() ||
        (userId.size() > 8 && userId.matches('^student_[a-zA-Z0-9_\\-]+$') && ('email' in resource.data) && ('email' in request.auth.token) && resource.data.email.lowerAscii() == request.auth.token.email.lowerAscii())
      );
      allow list: if isSignedIn();
    }

    // 2. Rankings Collection
    match /rankings/{rankId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isSignedIn() && (
          rankId == request.auth.uid || 
          (rankId.size() > 8 && rankId.matches('^student_[a-zA-Z0-9_\\-]+$') && 
           rankId == 'student_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentId', 'none'))
        )
      );
    }

    // 3. Criteria Scores Collection
    match /criteria_scores/{scoreId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() && (
          scoreId == request.auth.uid ||
          (scoreId.size() > 8 && scoreId.matches('^student_[a-zA-Z0-9_\\-]+$') && 
           scoreId == 'student_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentId', 'none'))
        )
      );
    }

    // 4. Scholarships Collection
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Scholarship Applications
    match /scholarship_applications/{appId} {
      allow read: if isAdmin() || 
                    (isSignedIn() && (
                      resource.data.studentId == request.auth.uid ||
                      resource.data.studentId == 'student_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentId', 'none')
                    )) ||
                    (resource.data.get('status', 'none') == 'approved');
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || 
                    (isSignedIn() && (
                      resource.data.studentId == request.auth.uid &&
                      (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
                    ));
      allow delete: if isAdmin() ||
                    (isSignedIn() && (
                      resource.data.studentId == request.auth.uid ||
                      resource.data.studentId == 'student_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentId', 'none')
                    ));
    }

    // 6. Complaints
    match /complaints/{complaintId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.studentId == request.auth.uid);
        allow create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.studentId == request.auth.uid);
      }
    }

    // 7. Criteria
    match /criteria/{criterionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Classes
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. News
    match /news/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // 10. Users Lookup (to resolve temporary pre-registered profiles)
    match /users_lookup/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    
    // Testing path
    match /test/connection {
      allow read: if true;
    }
  }
}
